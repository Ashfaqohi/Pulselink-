{
  "title": "PulseLink user impact",
  "uid": "pulselink-user-impact",
  "schemaVersion": 39,
  "refresh": "15s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Redirect success rate",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"refId": "A", "expr": "sum(rate(redirect_requests_total{outcome=\"success\"}[5m])) / clamp_min(sum(rate(redirect_requests_total[5m])), 0.000001)"}],
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Redirect p95 latency",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"refId": "A", "expr": "redirect_request_duration_seconds{quantile=\"0.95\"}"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "type": "logs",
      "title": "Structured request logs",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 8},
      "targets": [{"refId": "A", "expr": "{container=\"url_short-backend-1\"}"}]
    }
  ],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"}
}
